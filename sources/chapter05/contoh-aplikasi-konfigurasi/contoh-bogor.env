# Contoh konfigurasi RS Bogor untuk app.py Bab 05. Semua nilai rekaan, jangan isi kunci asli.
# Pakai: salin setiap baris menjadi environment variable sebelum menjalankan app.py.
KODE_RUMAH_SAKIT=RS-BOGOR
ALAMAT_BASIS_DATA=postgresql://simrs-bogor.internal.example:5432/jadwal
KUNCI_AKSES_BPJS=ganti-dengan-kunci-dari-pengelola-rahasia
PORT=8080
