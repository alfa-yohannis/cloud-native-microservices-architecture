<!-- Templat context map Bab 06. Buka di diagrams.net (draw.io), salin kotak konteks dan panah, lalu ganti isinya dengan hasil lokakarya tim. -->
<mxfile host="app.diagrams.net" type="device">
  <diagram id="context-map-c2" name="Context Map Kondisi Saat Ini">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169"
      pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="judul" value="Context map kondisi saat ini: (nama organisasi), alur (nama alur)"
          style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="batas-org" value="Batas organisasi"
          style="rounded=1;dashed=1;fillColor=none;strokeColor=#257147;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;fontColor=#257147;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="760" height="420" as="geometry" />
        </mxCell>
        <mxCell id="luar-1" value="Sistem eksternal 1&lt;br&gt;&lt;i&gt;contoh: BPJS Kesehatan&lt;/i&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;"
          vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="luar-2" value="Sistem eksternal 2&lt;br&gt;&lt;i&gt;contoh: SATUSEHAT&lt;/i&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="konteks-a" value="&lt;b&gt;Konteks A&lt;/b&gt;&lt;br&gt;subdomain: core / supporting / generic&lt;br&gt;tim pemilik:"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="konteks-b" value="&lt;b&gt;Konteks B&lt;/b&gt;&lt;br&gt;subdomain:&lt;br&gt;tim pemilik:"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="konteks-c" value="&lt;b&gt;Konteks C&lt;/b&gt;&lt;br&gt;subdomain:&lt;br&gt;tim pemilik:"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;"
          vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="konteks-d" value="&lt;b&gt;Konteks D&lt;/b&gt;&lt;br&gt;subdomain:&lt;br&gt;tim pemilik:"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="konteks-e" value="&lt;b&gt;Konteks E&lt;/b&gt;&lt;br&gt;subdomain:&lt;br&gt;tim pemilik:"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hubungan-1" value="conformist"
          style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=2;"
          edge="1" parent="1" source="luar-1" target="konteks-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hubungan-2" value="customer-supplier"
          style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=2;"
          edge="1" parent="1" source="konteks-b" target="konteks-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hubungan-3" value="shared kernel"
          style="endArrow=none;html=1;strokeWidth=3;shape=link;fontStyle=2;"
          edge="1" parent="1" source="konteks-d" target="konteks-e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hubungan-4" value="anticorruption layer"
          style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontStyle=2;"
          edge="1" parent="1" source="luar-2" target="konteks-e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hubungan-5" value="tanpa pola (masalah)"
          style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;strokeColor=#b85450;fontColor=#b85450;"
          edge="1" parent="1" source="konteks-a" target="konteks-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="keterangan" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Panah menunjuk dari hulu (upstream) ke hilir (downstream).&lt;br&gt;Label panah: customer-supplier, conformist, anticorruption layer, shared kernel, open host service, published language, partnership, separate ways.&lt;br&gt;Kotak oranye: konteks yang menjadi prioritas perbaikan.&lt;br&gt;Garis merah putus-putus: hubungan tanpa pola, misalnya membaca basis data langsung.&lt;br&gt;Setiap kotak diberi jenis subdomain dan tim pemilik."
          style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="760" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
